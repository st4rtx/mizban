# Used by scripts/build-image.sh: everything is built on the developer machine, the image only packages it.
FROM node:20-alpine
ENV NODE_ENV=production WEB_DIST=/app/web/dist
WORKDIR /app
COPY .build/server/ /app/
COPY .build/web-dist /app/web/dist
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
USER node
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD wget -qO- http://127.0.0.1:8080/ready || exit 1
ENTRYPOINT ["sh", "/app/docker-entrypoint.sh"]
