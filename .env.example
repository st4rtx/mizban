# Copy to .env and fill in. NEVER commit .env.
POSTGRES_IMAGE=postgres:16-alpine
DB_ADMIN_PASSWORD=change-me-admin
APP_DB_PASSWORD=change-me-app
# 32+ random chars: openssl rand -hex 32
SESSION_SECRET=
COOKIE_SECURE=false
DEMO_MODE=true
ALLOWED_ORIGINS=
# AI brief (optional; without it the report falls back to a plain template)
AI_API_KEY=
AI_BASE_URL=https://api.gapgpt.app/v1
AI_MODEL=gpt-4o-mini
# reverse proxies in front of the app (nginx = 1). Only X-Forwarded-For from these hops is trusted.
TRUST_PROXY_HOPS=1
